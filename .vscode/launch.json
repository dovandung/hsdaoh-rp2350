{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pico Debug (Cortex-Debug)",
            "cwd": "${workspaceRoot}",
            "executable": "${input:picoTarget}",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "gdbPath": "${command:raspberry-pi-pico.getGDBPath}",
            "debuggerArgs": [
                "-ex",
                "set debug-file-directory /debug"
            ],
            "device": "${command:raspberry-pi-pico.getChipUppercase}",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/${command:raspberry-pi-pico.getTarget}.cfg"
            ],
            "svdFile": "${userHome}/.pico-sdk/sdk/2.3.1/src/${command:raspberry-pi-pico.getChip}/hardware_regs/${command:raspberry-pi-pico.getChipUppercase}.svd",
            "runToEntryPoint": "main",
            "overrideLaunchCommands": [
                "monitor reset init",
                "load \"${input:picoTarget}\""
            ],
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ]
        },
        {
            "name": "Pico Debug (Cortex-Debug with external OpenOCD)",
            "cwd": "${workspaceRoot}",
            "executable": "${input:picoTarget}",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "external",
            "gdbTarget": "localhost:3333",
            "gdbPath": "${command:raspberry-pi-pico.getGDBPath}",
            "debuggerArgs": [
                "-ex",
                "set debug-file-directory /debug"
            ],
            "device": "${command:raspberry-pi-pico.getChipUppercase}",
            "svdFile": "${userHome}/.pico-sdk/sdk/2.3.1/src/${command:raspberry-pi-pico.getChip}/hardware_regs/${command:raspberry-pi-pico.getChipUppercase}.svd",
            "runToEntryPoint": "main",
            "overrideLaunchCommands": [
                "monitor reset init",
                "load \"${input:picoTarget}\""
            ]
        }
    ],
    "inputs": [
        {
            "id": "picoTarget",
            "type": "pickString",
            "description": "Program to flash / debug",
            "options": [
                "${workspaceFolder}/build/apps/logic_analyzer_8bit/logic_analyzer_8bit.elf",
                "${workspaceFolder}/build/apps/logic_analyzer_8bit/logic_analyzer_8bit_triggered.elf",
                "${workspaceFolder}/build/apps/logic_analyzer/logic_analyzer.elf"
            ],
            "default": "${workspaceFolder}/build/apps/logic_analyzer_8bit/logic_analyzer_8bit.elf"
        }
    ]
}
