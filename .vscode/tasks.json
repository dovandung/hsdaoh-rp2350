{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Project",
            "type": "process",
            "isBuildCommand": true,
            "command": "${userHome}/.pico-sdk/ninja/v1.13.2/ninja",
            "args": [
                "-C",
                "${workspaceFolder}/build"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$gcc",
            "windows": {
                "command": "${userHome}/.pico-sdk/ninja/v1.13.2/ninja.exe"
            }
        },
        {
            "label": "Run Project",
            "type": "process",
            "command": "${env:HOME}/.pico-sdk/picotool/2.3.1/picotool/picotool",
            "args": [
                "load",
                "${input:picoTarget}",
                "-fx"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/picotool/2.3.1/picotool/picotool.exe"
            }
        },
        {
            "label": "Flash",
            "type": "process",
            "command": "openocd",
            "args": [
                "-s",
                "${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts",
                "-f",
                "interface/cmsis-dap.cfg",
                "-f",
                "target/${command:raspberry-pi-pico.getTarget}.cfg",
                "-c",
                "adapter speed 5000; program \"${input:picoTarget}\" verify reset exit"
            ],
            "problemMatcher": [],
            "windows": {
                "command": "openocd"
            }
        },
        {
            "label": "Rescue Reset",
            "type": "process",
            "command": "openocd",
            "args": [
                "-s",
                "${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts",
                "-f",
                "interface/cmsis-dap.cfg",
                "-f",
                "target/${command:raspberry-pi-pico.getChip}-rescue.cfg",
                "-c",
                "adapter speed 5000; reset halt; exit"
            ],
            "problemMatcher": [],
            "windows": {
                "command": "openocd"
            }
        },
        {
            "label": "RISC-V Reset (RP2350)",
            "type": "process",
            "command": "openocd",
            "args": [
                "-s",
                "${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts",
                "-c",
                "set USE_CORE { rv0 rv1 cm0 cm1 }",
                "-f",
                "interface/cmsis-dap.cfg",
                "-f",
                "target/rp2350.cfg",
                "-c",
                "adapter speed 5000; init;",
                "-c",
                "write_memory 0x40120158 8 { 0x3 }; echo [format \"Info : ARCHSEL 0x%02x\" [read_memory 0x40120158 8 1]];",
                "-c",
                "reset halt; targets rp2350.rv0; echo [format \"Info : ARCHSEL_STATUS 0x%02x\" [read_memory 0x4012015C 8 1]]; exit"
            ],
            "problemMatcher": [],
            "windows": {
                "command": "openocd"
            }
        }
    ],
    "inputs": [
        {
            "id": "picoTarget",
            "type": "pickString",
            "description": "Program to flash / debug",
            "options": [
                "${workspaceFolder}/build/apps/logic_analyzer/logic_analyzer.elf",
                "${workspaceFolder}/build/apps/logic_analyzer/logic_analyzer_triggered.elf",
                "${workspaceFolder}/build/apps/logic_analyzer/logic_analyzer_8bit.elf",
                "${workspaceFolder}/build/apps/logic_analyzer/logic_analyzer_8bit_triggered.elf"
            ],
            "default": "${workspaceFolder}/build/apps/logic_analyzer/logic_analyzer.elf"
        }
    ]
}
